# 复制为 .env 后填写。前三项没有默认值，缺失时 compose 会直接报错而不是用弱口令启动。

# 数据库
POSTGRES_USER=newgate
POSTGRES_DB=newgate
# 必填：数据库密码
POSTGRES_PASSWORD=

# 必填：管理台 JWT 签名密钥。生成：openssl rand -base64 48
JWT_SECRET=

# 强烈建议：渠道 API Key 的加密主密钥（base64 编码的 32 字节）。
# 生成：openssl rand -base64 32
# 留空则渠道 Key 明文入库——数据库泄露等于上游厂商 Key 全部泄露。
CHANNEL_KEY_ENC_KEY=

# 对外端口
NEWGATE_PORT=7080

# 上游在内网/自托管时才设为 true。默认 false：拒绝回环、内网、链路本地
# 与云元数据地址，防止网关被当作打内网的跳板（SSRF）。
ALLOW_PRIVATE_UPSTREAM=false

# 双轨计价（可选）。模型表里存的一律是官方价（= 成本轨基准）：
#   收入 = 售价轨 × 用户组倍率，售价 = 模型 sale_override 逐字段覆盖，未覆盖字段 = 官方价 × SALE_MARKUP；
#   成本 = 官方价 × 渠道 cost_discount，只用于毛利核算，不进用户账务。
# 取值 (0,100]，默认 1（不加价）。填非法值会让所有中转请求在入口被拒
# （500 model_pricing_invalid）——账务宁可拒绝也不猜价。
SALE_MARKUP=1

# 发布闸门：售价每一维必须 ≥ 官方成本 × MIN_MARGIN，否则管理台拒绝保存该定价（400）。
# 默认 1 = 售价不得低于官方成本；要强制最低毛利就调高，例如 1.2 = 至少 20% 毛利。
MIN_MARGIN=1

# ─── 以下都是可选，但每一项都对应一个「不填就不可用」的功能 ───

# 充值汇率：每 1 单位法币最小分（pay_orders.price）发多少 μUSD 额度（1 USD = 1000000 μUSD）。
# ⚠️ 不填 = **充值功能整个不可用**，用户每次下单都拿到 500「quota recharge is not configured」。
# 这是有意的：静默按 1:1 发放等于白送钱，而且不会留下任何日志痕迹 —— 账务宁可拒绝也不猜汇率。
# 没有普适默认值：它取决于你按什么币种定价、以及你想让「1 元」对应多少额度，必须自己算一次。
QUOTA_PER_PRICE_UNIT=

# 支付回调地址（要收真钱就得填，两项都必须是**公网可访问**的绝对地址）。
# PAY_NOTIFY_BASE = 后端对外的 origin（反向代理那个），渠道服务器要能从它打到
#   ${PAY_NOTIFY_BASE}/app/pay/channel-notify/{渠道码}
# PAY_RETURN_URL  = 用户付完跳回的控制台账单页，例如 https://console.example.com/billing
#
# 两项留空都不会让支付失败，但**各自退化一处**，互不牵连：
#   NOTIFY_BASE 空 → 渠道不主动回调，到账靠 pay-order-reconcile 定时查单兜底。延迟是十来分钟
#     而不是整十分钟：十分钟一轮，且刚下单 2 分钟内的单会被跳过。
#   RETURN_URL 空 → 用户付完停在渠道自己的页面上回不来（这一项与渠道回不回调无关，
#     别把它当成到账问题去查）。
# ⚠️ 没填 NOTIFY_BASE 就别在后台停用 pay-order-reconcile：两条到账路径全断 = 钱会到账、
#   额度永远不发（启动时这个组合会记一行 ERROR，但只在启动时查一次）。
# 漏写 https:// 之类的非法值**不会**被静默当成没配：按未配置处理并记 ERROR ——
# 一个不带 scheme 的地址会被渠道判成非法参数，那是连单都下不了，比没有回调严重得多。
# 生效值与状态在启动日志里（INFO=已生效 / WARN=未配置 / ERROR=非法或两条路径全断）：
#   grep "payment.callback-url"
PAY_NOTIFY_BASE=
PAY_RETURN_URL=

# 前置反向代理时必填：它决定网关认哪个地址是「客户端」，令牌 IP 白名单完全建在它上面。
# 不填 = 不信任任何转发头（X-Forwarded-For / X-Real-IP 一律忽略，直接用 TCP 对端地址），
# 直连部署就该这样。填了 = 从 XFF **最右**往左剥掉每一跳可信代理，停在第一个不可信地址。
# 不填而实际挂了反代的后果：IP 白名单看到的是代理自己的地址 —— 要么全部放行要么全部拒绝，
# 而两者都看起来像白名单生效了。格式：逗号分隔的精确 IP 或 IPv4 CIDR（IPv6 只能写精确地址）。
TRUSTED_PROXIES=

# 按会员分组计价（true 开启）。开启后每个会员组映射到一个计费组倍率；
# 缺映射一律拒绝请求（500 billing_group_config_broken），不静默回落 default ——
# 静默回落的后果是运营以为给这批用户配了 vip 价，而差额不会出现在任何日志里。
MEMBER_GROUP_BILLING=

# 邀请奖励，单位 μUSD。留空或 0 = 该角色不发奖。
# 默认不发：发钱的路径不该因为一次升级就自己打开，要开必须显式填。
# 非法值（1e3 / -5 / 带单位的串）**不会**被静默当成 0：该角色不发奖并记 ERROR，
# 因为「运营以为活动已上线、客服按活动口径答复用户、而账上什么都没有」比不发奖糟得多。
# 另一个角色不受影响（inviter 配错不会连累 invitee）。生效值在启动日志里：
#   grep "invite reward attached" 日志文件
# 幂等由台账 ref 钉住（invite:{记录id}:inviter / :invitee），补发不会二次入账；
# 补发入口：POST /admin/member/invite-code/retry-invite-reward/{recordId}。
INVITE_REWARD_INVITER=
INVITE_REWARD_INVITEE=
