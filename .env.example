# 复制为 .env 后填写。前三项没有默认值，缺失时 compose 会直接报错而不是用弱口令启动。

# 数据库
POSTGRES_USER=newgate
POSTGRES_DB=newgate
# 必填：数据库密码
POSTGRES_PASSWORD=

# 必填：管理台 JWT 签名密钥。生成：openssl rand -base64 48
JWT_SECRET=

# 强烈建议：渠道 API Key 的加密主密钥（base64 编码的 32 字节）。
# 生成：openssl rand -base64 32
# 留空则渠道 Key 明文入库——数据库泄露等于上游厂商 Key 全部泄露。
CHANNEL_KEY_ENC_KEY=

# 对外端口
NEWGATE_PORT=7080

# 上游在内网/自托管时才设为 true。默认 false：拒绝回环、内网、链路本地
# 与云元数据地址，防止网关被当作打内网的跳板（SSRF）。
ALLOW_PRIVATE_UPSTREAM=false
