# 复制为 .env 后填写。前三项没有默认值，缺失时 compose 会直接报错而不是用弱口令启动。

# 数据库
POSTGRES_USER=newgate
POSTGRES_DB=newgate
# 必填：数据库密码
POSTGRES_PASSWORD=

# 必填：管理台 JWT 签名密钥。生成：openssl rand -base64 48
JWT_SECRET=

# 强烈建议：渠道 API Key 的加密主密钥（base64 编码的 32 字节）。
# 生成：openssl rand -base64 32
# 留空则渠道 Key 明文入库——数据库泄露等于上游厂商 Key 全部泄露。
CHANNEL_KEY_ENC_KEY=

# 对外端口
NEWGATE_PORT=7080

# 上游在内网/自托管时才设为 true。默认 false：拒绝回环、内网、链路本地
# 与云元数据地址，防止网关被当作打内网的跳板（SSRF）。
ALLOW_PRIVATE_UPSTREAM=false

# 双轨计价（可选）。模型表里存的一律是官方价（= 成本轨基准）：
#   收入 = 售价轨 × 用户组倍率，售价 = 模型 sale_override 逐字段覆盖，未覆盖字段 = 官方价 × SALE_MARKUP；
#   成本 = 官方价 × 渠道 cost_discount，只用于毛利核算，不进用户账务。
# 取值 (0,100]，默认 1（不加价）。填非法值会让所有中转请求在入口被拒
# （500 model_pricing_invalid）——账务宁可拒绝也不猜价。
SALE_MARKUP=1

# 发布闸门：售价每一维必须 ≥ 官方成本 × MIN_MARGIN，否则管理台拒绝保存该定价（400）。
# 默认 1 = 售价不得低于官方成本；要强制最低毛利就调高，例如 1.2 = 至少 20% 毛利。
MIN_MARGIN=1
